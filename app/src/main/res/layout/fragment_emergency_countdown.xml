<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shield_light_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Chiamata dei\nsoccorsi..."
        android:textColor="@color/emergency_red"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:gravity="center"
        android:text="00:10"
        android:textColor="@color/black"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="secondi rimanenti"
        android:textColor="@color/black"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancelEmergency"
        android:layout_width="220dp"
        android:layout_height="62dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/bg_purple_button"
        android:text="Annulla"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>